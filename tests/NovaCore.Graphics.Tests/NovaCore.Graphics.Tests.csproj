<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><PlatformTarget>x64</PlatformTarget><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NovaCore.Core\NovaCore.Core.csproj" />
    <ProjectReference Include="..\..\src\NovaCore.Graphics\NovaCore.Graphics.csproj" />
    <ProjectReference Include="..\..\src\NovaCore.Interop\NovaCore.Interop.csproj" />
    <ProjectReference Include="..\..\src\NovaCore.Simulation\NovaCore.Simulation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\samples\NovaCore.Triangle\StaticReferenceFrameFixtureSceneFactory.cs" Link="StaticReferenceFrameFixtureSceneFactory.cs" />
    <Compile Include="..\..\samples\NovaCore.Triangle\DynamicReferenceFrameFixtureScene.cs" Link="DynamicReferenceFrameFixtureScene.cs" />
    <Compile Include="..\..\samples\NovaCore.Triangle\CelestialAnalyticalScene.cs" Link="CelestialAnalyticalScene.cs" />
    <Compile Include="..\..\samples\NovaCore.Triangle\EarthPlanetaryScene.cs" Link="EarthPlanetaryScene.cs" />
  </ItemGroup>
  <Target Name="CopyNativeRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\native-ninja\NovaCore.Native.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><PlatformTarget>x64</PlatformTarget><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <PropertyGroup><NativeRuntimeContentProducer>true</NativeRuntimeContentProducer></PropertyGroup>
  <Import Project="../../tools/RuntimeShaderDeployment.targets" />
  <ItemGroup>
    <Content Include="..\..\assets\visual\SRV01\*.glb" Link="assets\visual\SRV01\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\NovaCore.Core\NovaCore.Core.csproj" />
    <ProjectReference Include="..\..\src\NovaCore.Graphics\NovaCore.Graphics.csproj" />
    <ProjectReference Include="..\..\src\NovaCore.Interop\NovaCore.Interop.csproj" />
    <ProjectReference Include="..\..\src\NovaCore.Platform\NovaCore.Platform.csproj" />
    <ProjectReference Include="..\..\src\NovaCore.Simulation\NovaCore.Simulation.csproj" />
  </ItemGroup>
  <Target Name="CopyEarthElevation" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\assets\earth\runtime\earth_elevation_8192x4096.r16" DestinationFolder="$(OutDir)earth-data" SkipUnchangedFiles="true" />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><PlatformTarget>x64</PlatformTarget><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <PropertyGroup>
    <NativeBuildDirectory Condition="'$(NativeBuildDirectory)' == '' and '$(Configuration)' == 'Release'">native-ninja-release</NativeBuildDirectory>
    <NativeBuildDirectory Condition="'$(NativeBuildDirectory)' == ''">native-ninja</NativeBuildDirectory>
    <NativeRuntimeRoot>$(MSBuildThisFileDirectory)..\..\build\$(NativeBuildDirectory)\</NativeRuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\assets\visual\SRV01\*.glb" Link="assets\visual\SRV01\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\NovaCore.Core\NovaCore.Core.csproj" />
    <ProjectReference Include="..\..\src\NovaCore.Graphics\NovaCore.Graphics.csproj" />
    <ProjectReference Include="..\..\src\NovaCore.Interop\NovaCore.Interop.csproj" />
    <ProjectReference Include="..\..\src\NovaCore.Platform\NovaCore.Platform.csproj" />
    <ProjectReference Include="..\..\src\NovaCore.Simulation\NovaCore.Simulation.csproj" />
  </ItemGroup>
  <!-- Native runtime content belongs to the renderer and flows through project references
       to ConstructionEditor and NovaCore.App for both build and publish. Build native first. -->
  <ItemGroup>
    <RuntimeShader Include="$(NativeRuntimeRoot)shaders\*.spv" />
    <Content Include="@(RuntimeShader)" Link="shaders\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NativeRuntimeRoot)NovaCore.Native.dll" Link="NovaCore.Native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateNativeRuntimeContent" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems;ComputeFilesToPublish">
    <Error Condition="!Exists('$(NativeRuntimeRoot)NovaCore.Native.dll')" Text="Native runtime is missing from $(NativeRuntimeRoot). Build the matching native configuration before building or publishing the application." />
    <Error Condition="'@(RuntimeShader)' == ''" Text="Native SPIR-V shader package is empty in $(NativeRuntimeRoot)shaders. Build the matching native configuration before building or publishing the application." />
  </Target>
  <Target Name="CopyEarthElevation" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\assets\earth\runtime\earth_elevation_8192x4096.r16" DestinationFolder="$(OutDir)earth-data" SkipUnchangedFiles="true" />
  </Target>
</Project>

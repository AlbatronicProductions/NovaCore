      <ExpectedShader Include="@(RuntimeShader->'$(OutDir)shaders\%(Filename)%(Extension)')" />
      <ExistingShader Include="$(OutDir)shaders\*.spv" />
      <StaleShader Include="@(ExistingShader)" Exclude="@(ExpectedShader)" />
    </ItemGroup>
    <Delete Files="@(StaleShader)" />
    <Copy SourceFiles="@(RuntimeShader)" DestinationFolder="$(OutDir)shaders" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\$(NativeBuildDirectory)\NovaCore.Native.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\assets\earth\runtime\earth_elevation_8192x4096.r16" DestinationFolder="$(OutDir)earth-data" SkipUnchangedFiles="true" />
  </Target>
</Project>

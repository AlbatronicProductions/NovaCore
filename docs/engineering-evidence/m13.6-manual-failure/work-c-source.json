    "powershellHelper": "\n$ErrorActionPreference='Stop'\n$opcodeMap=@{}\n[System.Reflection.Emit.OpCodes].GetFields([System.Reflection.BindingFlags]'Public,Static') | ForEach-Object { $op=$_.GetValue($null);$opcodeMap[[int]$op.Value -band 65535]=$op }\nfunction EntityText($reader,$handle) {\n $handle=[System.Reflection.Metadata.EntityHandle]$handle\n if($handle.IsNil){return '<nil>'}\n switch($handle.Kind.ToString()) {\n  'TypeDefinition' { $x=$reader.GetTypeDefinition([System.Reflection.Metadata.TypeDefinitionHandle]$handle);return $reader.GetString($x.Namespace)+'.'+$reader.GetString($x.Name) }\n  'TypeReference' { $x=$reader.GetTypeReference([System.Reflection.Metadata.TypeReferenceHandle]$handle);return $reader.GetString($x.Namespace)+'.'+$reader.GetString($x.Name) }\n  'MethodDefinition' { $x=$reader.GetMethodDefinition([System.Reflection.Metadata.MethodDefinitionHandle]$handle);return (EntityText $reader $x.GetDeclaringType())+'::'+$reader.GetString($x.Name) }\n  'FieldDefinition' { $x=$reader.GetFieldDefinition([System.Reflection.Metadata.FieldDefinitionHandle]$handle);return (EntityText $reader $x.GetDeclaringType())+'::'+$reader.GetString($x.Name) }\n  'MemberReference' { $x=$reader.GetMemberReference([System.Reflection.Metadata.MemberReferenceHandle]$handle);return (EntityText $reader $x.Parent)+'::'+$reader.GetString($x.Name) }\n  'MethodSpecification' { $x=$reader.GetMethodSpecification([System.Reflection.Metadata.MethodSpecificationHandle]$handle);return (EntityText $reader $x.Method)+'<...>' }\n  default { return $handle.Kind.ToString() }\n }\n}\nfunction ReadMethodIl($reader,$pe,$method,$handle) {\n $body=[System.Reflection.Metadata.PEReaderExtensions]::GetMethodBody($pe,$method.RelativeVirtualAddress);$bytes=$body.GetILBytes()\n $stream=[System.IO.MemoryStream]::new([byte[]]$bytes);$br=[System.IO.BinaryReader]::new($stream)\n $lines=[System.Collections.Generic.List[string]]::new()\n while($stream.Position -lt $stream.Length){\n  $pos=$stream.Position;$code=[int]$br.ReadByte();if($code -eq 254){$code=65024+[int]$br.ReadByte()}\n  $op=$opcodeMap[$code];$operand=''\n  switch($op.OperandType.ToString()){\n   'InlineNone' {}\n   'ShortInlineI' {$operand=$br.ReadSByte().ToString()}\n   'InlineI' {$operand=$br.ReadInt32().ToString()}\n   'InlineI8' {$operand=$br.ReadInt64().ToString()}\n   'ShortInlineR' {$operand=$br.ReadSingle().ToString('R')}\n   'InlineR' {$operand=$br.ReadDouble().ToString('R')}\n   'ShortInlineVar' {$operand=$br.ReadByte().ToString()}\n   'InlineVar' {$operand=$br.ReadUInt16().ToString()}\n   'ShortInlineBrTarget' {$jump=$br.ReadSByte();$operand='IL_{0:x4}' -f ($stream.Position+$jump)}\n   'InlineBrTarget' {$jump=$br.ReadInt32();$operand='IL_{0:x4}' -f ($stream.Position+$jump)}\n   'InlineSwitch' {$count=$br.ReadInt32();$jumps=@();for($j=0;$j -lt $count;$j++){$jumps+=$br.ReadInt32()};$base=$stream.Position;$operand=(@($jumps | ForEach-Object {'IL_{0:x4}' -f ($base+$_)}) -join ', ')}\n   'InlineString' {$token=$br.ReadInt32();$operand='\"'+$reader.GetUserString([System.Reflection.Metadata.Ecma335.MetadataTokens]::UserStringHandle($token -band 16777215))+'\"'}\n   default {$token=$br.ReadInt32();$operand=('{0:x8} ' -f $token)+(EntityText $reader ([System.Reflection.Metadata.Ecma335.MetadataTokens]::EntityHandle($token)))}\n  }\n  $lines.Add(('IL_{0:x4}: {1} {2}' -f $pos,$op.Name,$operand).TrimEnd())\n }\n $br.Dispose();$stream.Dispose()\n return [pscustomobject]@{Name=$reader.GetString($method.Name);Token=('{0:x8}' -f [System.Reflection.Metadata.Ecma335.MetadataTokens]::GetToken([System.Reflection.Metadata.EntityHandle]$handle));Rva=$method.RelativeVirtualAddress;IlBytes=$bytes.Length;IlSha256=[Convert]::ToHexString([System.Security.Cryptography.SHA256]::HashData([byte[]]$bytes)).ToLowerInvariant();Instructions=$lines.ToArray()}\n}\nfunction InspectType($dll,$typeName,$wanted){\n $stream=[System.IO.File]::OpenRead((Join-Path 'E:\\Kitten Space Agency' $dll));$pe=[System.Reflection.PortableExecutable.PEReader]::new($stream);$reader=[System.Reflection.Metadata.PEReaderExtensions]::GetMetadataReader($pe)\n $answer=@()\n foreach($typeHandle in $reader.TypeDefinitions){\n  $type=$reader.GetTypeDefinition($typeHandle)\n  if($reader.GetString($type.Namespace)+'.'+$reader.GetString($type.Name) -ne $typeName){continue}\n  foreach($methodHandle in $type.GetMethods()){\n   $method=$reader.GetMethodDefinition($methodHandle);$name=$reader.GetString($method.Name)\n   if(($wanted -contains $name) -and $method.RelativeVirtualAddress -ne 0){$answer+=ReadMethodIl $reader $pe $method $methodHandle}\n  }\n }\n $pe.Dispose();$stream.Dispose();return $answer\n}\n",
    "example": "InspectType 'Planet.Render.Core.dll' 'Core.Renderer' @('TryAcquireNextFrame','PresentFrame','CreateSwapchain') | ConvertTo-Json -Depth 5"
  },

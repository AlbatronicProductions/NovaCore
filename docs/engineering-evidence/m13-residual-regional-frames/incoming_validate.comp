#version 460
#extension GL_ARB_gpu_shader_fp64 : require
// Private causal control: validate real topology/physical completeness, without
// building a camera-specific list that is overwritten before its first draw.
layout(local_size_x=64) in;
struct PhysicalVertex{dvec4 body;vec4 normal;vec4 reserved;};
layout(set=0,binding=45,std430) readonly buffer Physical{PhysicalVertex values[];} physical;
layout(set=0,binding=46,std430) readonly buffer Indices{uint values[];} indices;
layout(set=0,binding=50,std430) buffer Counters{uint values[];} counters;
shared uint invalid;
bool valid(uint i){
  if(i>=counters.values[6])return false;
  dvec3 p=physical.values[i].body.xyz;vec4 n=physical.values[i].normal;
  return !any(isnan(p))&&!any(isinf(p))&&n.w==1.0&&!any(isnan(n.xyz))&&!any(isinf(n.xyz));
}
void main(){
  uint lane=gl_LocalInvocationID.x,triangle=gl_GlobalInvocationID.x,total=counters.values[5];
  if(lane==0u)invalid=0u;
  barrier();
  if(triangle<total){
    uint i0=indices.values[triangle*3u],i1=indices.values[triangle*3u+1u],i2=indices.values[triangle*3u+2u];
    if(!valid(i0)||!valid(i1)||!valid(i2))atomicAdd(invalid,1u);
  }
  barrier();
  if(lane==0u){
    atomicAdd(counters.values[23],min(64u,total-gl_WorkGroupID.x*64u));
    if(invalid!=0u)atomicAdd(counters.values[3],invalid);
  }
}

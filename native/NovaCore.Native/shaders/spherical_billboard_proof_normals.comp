#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer LocalVertices { uvec4 values[]; } localVertices;
layout(set=0,binding=2,std430) readonly buffer NeighborOffsets { uint values[]; } offsets;
layout(set=0,binding=3,std430) readonly buffer Neighbors { uint values[]; } neighbors;
layout(set=0,binding=5,std430) writeonly buffer PreparedNormals { vec4 values[]; } normals;
layout(set=0,binding=11,std430) readonly buffer PhysicalNormals { vec4 values[]; } physicalNormals;
layout(push_constant) uniform Constants {
  uint baseVertexCount; uint baseTriangleCount; uint workVertexCount; uint workTriangleCount;
  float bodyRadius; float cameraDistance; float tanHalfFov; float aspect;
  uint topologyLevel; uint frameIndex; uint outputIndexCapacity; uint reserved;
  uint coordinateEncoding; uint latticeScale;
} pc;
vec3 DecodeDirection(uint id){
  uvec3 raw=localVertices.values[id].xyz;
  if(pc.coordinateEncoding==1u)return normalize(vec3(ivec3(raw))/float(pc.latticeScale));
  return normalize(uintBitsToFloat(raw));
}
void main(){
  uint id=gl_GlobalInvocationID.x; if(id>=pc.workVertexCount)return;
  uint local=id%pc.baseVertexCount; uint begin=offsets.values[local]; uint end=offsets.values[local+1u];
  if(pc.reserved!=0u){normals.values[id]=physicalNormals.values[local];return;}
  vec3 center=DecodeDirection(local); vec3 curvature=vec3(0.0);
  for(uint i=begin;i<end;i++) curvature+=center-DecodeDirection(uint(neighbors.values[i]));
  vec3 normal=dot(curvature,curvature)>1e-18?normalize(curvature):center;
  if(dot(normal,center)<0.0)normal=-normal;
  normals.values[id]=vec4(normal,1.0);
}

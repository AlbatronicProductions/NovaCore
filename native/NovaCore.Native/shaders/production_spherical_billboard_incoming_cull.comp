void main(){uint triangle=gl_GlobalInvocationID.x,total=counters.values[5];if(triangle>=total)return;uint i0=indices.values[triangle*3u],i1=indices.values[triangle*3u+1u],i2=indices.values[triangle*3u+2u];uint vertexCount=counters.values[6];if(i0>=vertexCount||i1>=vertexCount||i2>=vertexCount){visibility.values[triangle]=0u;atomicAdd(counters.values[3],1u);return;}dvec3 p0=physical.values[i0].body.xyz,p1=physical.values[i1].body.xyz,p2=physical.values[i2].body.xyz;vec4 n0=physical.values[i0].normal,n1=physical.values[i1].normal,n2=physical.values[i2].normal;bool normalsReady=n0.w==1.0&&n1.w==1.0&&n2.w==1.0&&!any(isnan(n0.xyz))&&!any(isinf(n0.xyz))&&!any(isnan(n1.xyz))&&!any(isinf(n1.xyz))&&!any(isnan(n2.xyz))&&!any(isinf(n2.xyz));if(!finite3(p0)||!finite3(p1)||!finite3(p2)||!normalsReady){visibility.values[triangle]=0u;atomicAdd(counters.values[3],1u);return;}dvec3 center=(p0+p1+p2)/3.0,n=cross(p1-p0,p2-p0),camera=dvec3(inputData.cameraHighRadiusHigh.xyz)+dvec3(inputData.cameraLowRadiusLow.xyz);double radius=max(length(p0-center),max(length(p1-center),length(p2-center)))+0.02;if(dot(n,camera-center)<=-radius*length(n)/max(length(center),1.0)){visibility.values[triangle]=0u;atomicAdd(counters.values[1],1u);return;}visibility.values[triangle]=1u;atomicAdd(counters.values[0],1u);}

#version 450
layout(local_size_x=64) in;
layout(set=0,binding=1,std430) readonly buffer TriangleIndices { uint values[]; } indices;
layout(set=0,binding=6,std430) writeonly buffer VisibleIndices { uint values[]; } visibleIndices;
layout(set=0,binding=7,std430) buffer DrawArgs { uint args[]; } drawArgs;
layout(set=0,binding=8,std430) buffer Counters { uint values[]; } counters;
layout(set=0,binding=9,std430) readonly buffer Visibility { uint values[]; } visibility;
layout(push_constant) uniform Constants {
  uint baseVertexCount; uint baseTriangleCount; uint workVertexCount; uint workTriangleCount;
  float bodyRadius; float cameraDistance; float tanHalfFov; float aspect;
  uint topologyLevel; uint frameIndex; uint outputIndexCapacity; uint reserved;
  uint coordinateEncoding; uint latticeScale;
} pc;
void main(){
  uint id=gl_GlobalInvocationID.x; if(id>=pc.workTriangleCount||visibility.values[id]==0u)return;
  uint destination=atomicAdd(drawArgs.args[0],3u);
  if(destination+2u>=pc.outputIndexCapacity){atomicAdd(counters.values[3],1u);atomicMin(drawArgs.args[0],pc.outputIndexCapacity);return;}
  uint sourceTriangle=id%pc.baseTriangleCount; uint availableBatches=max(1u,pc.workVertexCount/pc.baseVertexCount);
  uint base=(id/pc.baseTriangleCount%availableBatches)*pc.baseVertexCount;
  visibleIndices.values[destination+0u]=base+indices.values[sourceTriangle*3u+0u];
  visibleIndices.values[destination+1u]=base+indices.values[sourceTriangle*3u+1u];
  visibleIndices.values[destination+2u]=base+indices.values[sourceTriangle*3u+2u];
}

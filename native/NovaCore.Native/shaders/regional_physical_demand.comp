#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_gpu_shader_fp64 : require
#include "production_cube_surface.glsl"
#include "regional_physical.glsl"
layout(local_size_x=64) in;
struct PupilFrame{dvec4 east;dvec4 north;dvec4 up;dvec4 transition;uvec4 identity;uvec4 metadata;};
layout(set=0,binding=55,std430) buffer RegionalDemand{
  PupilFrame frames[2];uint masks[56];uint offsets[2];
} demand;
layout(set=0,binding=44,std430) readonly buffer Lattice{ivec4 values[];} lattice;
double transitionWeight(ivec3 value,PupilFrame frame)
{
  if(value.z!=int(frame.identity.w))return 0.0;
  double radius=length(dvec2(value.xy))/double(frame.identity.w);
  if(radius<=frame.up.w)return 1.0;
  if(radius>=frame.transition.x)return 0.0;
  double t=(radius-frame.up.w)/(frame.transition.x-frame.up.w);
  double eased=t*t*(3.0-2.0*t);
  return 1.0-eased;
}

dvec3 canonicalDirection(ivec3 value,PupilFrame frame)
{
  double weight=transitionWeight(value,frame);
  dvec3 local=normalize(dvec3(double(value.x)+frame.east.w*weight,
    double(value.y)+frame.north.w*weight,double(value.z)));
  return normalize(frame.east.xyz*local.x+frame.north.xyz*local.y+frame.up.xyz*local.z);
}


void requireDirection(dvec3 direction){dvec2 uv;int record=RegionalRecord(direction,uv);
 if(record>=0)atomicOr(demand.masks[0u*28u+uint(record)/32u],1u<<(uint(record)%32u));}
void main(){uint vertex=gl_GlobalInvocationID.x+demand.offsets[0];PupilFrame frame=demand.frames[0u];
 if(frame.metadata.x==0u||vertex>=frame.metadata.z)return;
 dvec3 d=canonicalDirection(lattice.values[vertex].xyz,frame);requireDirection(d);
 double h=d.x*d.x+d.z*d.z;dvec3 east=h>1e-24?dvec3(d.z,0,-d.x)/sqrt(h):dvec3(1,0,0);
 dvec3 north=normalize(cross(d,east));double angle=9774.0/frame.transition.y;
 requireDirection(normalize(d-east*angle));requireDirection(normalize(d+east*angle));
 requireDirection(normalize(d-north*angle));requireDirection(normalize(d+north*angle));
}

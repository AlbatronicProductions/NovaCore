#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_gpu_shader_fp64 : require
#include "production_cube_surface.glsl"
#define NOVACORE_REGIONAL_PHYSICAL
#include "regional_physical.glsl"
#include "physical_surface.glsl"
#include "planetary_physical_authority.glsl"
#include "planetary_natural_terrain_surface.glsl"
#include "production_spherical_billboard_physical.glsl"

layout(local_size_x=64) in;
struct PupilFrame{dvec4 east;dvec4 north;dvec4 up;dvec4 transition;uvec4 identity;uvec4 metadata;};
layout(set=0,binding=56,std430) readonly buffer PreparationControl{
  PupilFrame previous;PupilFrame current;PupilFrame incoming;uvec4 ranges[2];
} preparation;
layout(set=0,binding=52,std430) readonly buffer PupilFrames{PupilFrame previous;PupilFrame current;} pupilFrames;
layout(set=0,binding=44,std430) readonly buffer Lattice{ivec4 values[];} lattice;
struct PhysicalVertex{dvec4 body;vec4 normal;vec4 reserved;};
layout(set=0,binding=38,std430) buffer Physical{PhysicalVertex values[];} physical;
layout(set=0,binding=57,std430) buffer StagedPhysical{PhysicalVertex values[];} stagedPhysical;
void storePhysical(uint vertex,PhysicalVertex value){
  if(preparation.ranges[0].z!=0u)stagedPhysical.values[vertex]=value;
  else physical.values[vertex]=value;
}

double transitionWeight(ivec3 value,PupilFrame frame)
{
  if(value.z!=int(frame.identity.w))return 0.0;
  double radius=length(dvec2(value.xy))/double(frame.identity.w);
  if(radius<=frame.up.w)return 1.0;
  if(radius>=frame.transition.x)return 0.0;
  double t=(radius-frame.up.w)/(frame.transition.x-frame.up.w);
  double eased=t*t*(3.0-2.0*t);
  return 1.0-eased;
}

dvec3 canonicalDirection(ivec3 value,PupilFrame frame)
{
  double weight=transitionWeight(value,frame);
  dvec3 local=normalize(dvec3(double(value.x)+frame.east.w*weight,
    double(value.y)+frame.north.w*weight,double(value.z)));
  return normalize(frame.east.xyz*local.x+frame.north.xyz*local.y+frame.up.xyz*local.z);
}

void main()
{
  uint vertex=gl_GlobalInvocationID.x+preparation.ranges[0].x;
  PupilFrame current=preparation.ranges[0].z!=0u?preparation.current:pupilFrames.current;
  PupilFrame previous=preparation.ranges[0].z!=0u?preparation.previous:pupilFrames.previous;
  if(current.metadata.x==0u||vertex>=current.metadata.z)return;
  ivec3 value=lattice.values[vertex].xyz;
  dvec3 direction=canonicalDirection(value,current);
  if(previous.metadata.x!=0u&&previous.identity.z==current.identity.z&&
     previous.identity.w==current.identity.w)
  {
    dvec3 prior=canonicalDirection(value,previous);
    if(all(equal(prior,direction))){if(preparation.ranges[0].z!=0u)stagedPhysical.values[vertex]=physical.values[vertex];return;}
  }
  double radius=current.transition.y;
  // Shared terrain relief is prepared before render refinement. The alternate
  // branch exists only for the bounded M13.2 comparison.
  PhysicalVertex result;
#if NOVACORE_PREPARED_RENDER_TERRAIN
  // Physical/query relief is resolved at publication vertices. Final render
  // refinement interpolates this shared terrain; it does not reevaluate H.
  double height=CandidatePhysicalHeightD(direction);
  result.body=dvec4(direction*(radius+height),height);
  result.normal=vec4(CandidatePhysicalNormalD(direction,radius),1.0);
#else
  double height=CandidateBaseHeightD(direction);
  result.body=dvec4(direction*(radius+height),height);
  result.normal=vec4(CandidateBaseNormalD(direction,radius),1.0);
#endif
  result.reserved=vec4(0.0);
  // Test-only catalog queries use the same function as real geographic demand.
  if(vertex==3u&&regionalCatalog.entries[0].storage.w!=0u){
    dvec2 ignored;
    result.reserved=vec4(float(RegionalRecord(dvec3(1,0,0),ignored)),
      float(RegionalRecord(dvec3(0,1,0),ignored)),float(RegionalRecord(dvec3(0,0,1),ignored)),
      float(RegionalRecord(dvec3(0,0,-1),ignored)));
  }
  if(vertex<3u&&regionalCatalog.entries[0].storage.w!=0u){
    dvec3 anchor=dvec3(0.1433224599406355LF,0.4788205718227514LF,0.8661348234979923LF);
    double a,b;
    if(vertex==0u){a=CanonicalElevationOracleMetres(anchor);b=RegionalPhysicalResidual(anchor);}
    else if(vertex==1u){a=CandidateBaseHeightD(anchor);b=EvaluateNaturalCandidateD(anchor).nearField.height;}
    else{a=CanonicalGeographicHeight(anchor);b=CandidatePhysicalHeightD(anchor);}
    result.reserved=uintBitsToFloat(uvec4(unpackDouble2x32(a),unpackDouble2x32(b)));
  }
  storePhysical(vertex,result);
}
